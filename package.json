{
  "name": "portfolio-website-template",
  "version": "1.0.0",
  "description": "A modern, accessible, one-file-configurable portfolio website template built with Astro.",
  "author": "DamReboot IT Damian Chabracki",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://damtchorzewski.github.io/portfolio-website-template/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DamTchorzewski/portfolio-website-template.git"
  },
  "bugs": {
    "url": "https://github.com/DamTchorzewski/portfolio-website-template/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "health": "node scripts/health.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,css,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
