---
import { site } from "@/config/site";
import Icon from "./Icon.astro";

const { contact } = site;
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <div class="panel reveal">
      <div class="copy">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title" class="section-title">
          {contact.title}
        </h2>
        <p class="section-lead">{contact.text}</p>
        <p class="mail">
          <a class="btn btn--primary" href={`mailto:${contact.email}`}>
            <Icon name="mail" />
            {contact.email}
          </a>
        </p>
        {contact.links.length > 0 && (
          <ul class="links" aria-label="Profiles">
            {contact.links.map((link) => (
              <li>
                <a href={link.href} rel="noopener noreferrer">
                  {link.label}
                  <Icon name="arrow-up-right" />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      {contact.formAction && (
        <form class="form" action={contact.formAction} method="post">
          <label>
            Name
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            E-mail
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            Message
            <textarea name="message" rows="5" required />
          </label>
          <button class="btn btn--primary" type="submit">
            Send message
          </button>
        </form>
      )}
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    gap: 2.5rem;
    padding: clamp(1.75rem, 5vw, 4rem);
    border-radius: calc(var(--radius) * 1.5);
    background:
      radial-gradient(
        circle at 100% 0%,
        oklch(0.8 0.12 calc(var(--hue) + 40) / 0.35),
        transparent 50%
      ),
      var(--accent-soft);
  }

  @media (min-width: 60rem) {
    .panel:has(.form) {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .mail {
    margin-top: 2rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    color: var(--text);
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  .links a:hover {
    color: var(--accent);
  }

  .form {
    display: grid;
    gap: 1.1rem;
  }

  label {
    display: grid;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
</style>
